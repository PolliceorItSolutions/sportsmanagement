<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ============================
         USERS TABLE
         Firebase UID + first/last name
         ============================ -->
    <changeSet id="001-create-users" author="Avinash">
        <createTable tableName="users">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="firebase_uid" type="varchar(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="first_name" type="varchar(50)"/>
            <column name="last_name" type="varchar(50)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- ============================
         TEAMS TABLE
         ============================ -->
    <changeSet id="002-create-teams" author="Avinash">
        <createTable tableName="teams">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="contact_email" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="captain" type="varchar(255)"/>
            <column name="vice_captain" type="varchar(255)"/>
            <column name="president" type="varchar(255)"/>
            <column name="secretary" type="varchar(255)"/>
            <column name="treasurer" type="varchar(255)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- ============================
         PLAYERS TABLE
         ============================ -->
    <changeSet id="003-create-players" author="Avinash">
        <createTable tableName="players">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints unique="true"/>
            </column>
            <column name="team_id" type="bigint">
                <constraints foreignKeyName="fk_player_team" references="teams(id)"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- ============================
         GROUNDS TABLE
         ============================ -->
    <changeSet id="004-create-grounds" author="Avinash">
        <createTable tableName="grounds">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="location" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="capacity" type="int"/>
            <column name="earliest_start" type="time">
                <constraints nullable="false"/>
            </column>
            <column name="latest_end" type="time">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- ============================
         MATCH FORMATS TABLE
         ============================ -->
    <changeSet id="005-create-match-formats" author="Avinash">
        <createTable tableName="match_formats">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="duration_hours" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- ============================
         TEAM MEMBERS TABLE (Many-to-Many)
         ============================ -->
    <changeSet id="006-create-team-members" author="Avinash">
        <createTable tableName="team_members">
            <column name="team_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_team_members_team" references="teams(id)"/>
            </column>
            <column name="player_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_team_members_player" references="players(id)"/>
            </column>
            <column name="member_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="team_members" columnNames="team_id, player_id"/>
    </changeSet>

    <!-- ============================
         USER ROLES TABLE
         ============================ -->
    <changeSet id="007-create-user-roles" author="Avinash">
        <createTable tableName="user_roles">
            <column name="user_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_user_roles_user"
                             references="users(id)"/>
            </column>
            <column name="role" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="user_roles" columnNames="user_id, role" constraintName="pk_user_roles"/>
    </changeSet>

</databaseChangeLog>
